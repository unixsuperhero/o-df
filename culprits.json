{
  "relocate_to": "/Volumes/Backup/relocated",
  "culprits": [
    {"name": "npm-cache", "title": "npm download and npx cache", "category": "js", "paths": ["~/.npm/_cacache", "~/.npm/_npx"], "rebuildable": true, "rebuild": "npm install / npx download again", "recommend": "delete"},
    {"name": "bun-cache", "title": "bun install cache", "category": "js", "paths": ["~/.bun/install/cache"], "rebuildable": true, "rebuild": "bun install downloads again", "recommend": "delete", "notes": "~/.bun/install/global holds installed global tools; it is not part of this row"},
    {"name": "pnpm-store", "title": "pnpm content-addressed store", "category": "js", "paths": ["~/Library/pnpm/store", "~/.local/share/pnpm/store", "~/.pnpm-store", "~/Library/Caches/pnpm"], "rebuildable": true, "rebuild": "pnpm install refills it; hard-linked node_modules keep their files", "recommend": "delete"},
    {"name": "yarn-cache", "title": "Yarn cache", "category": "js", "paths": ["~/Library/Caches/Yarn", "~/.yarn/berry/cache", "~/.cache/yarn"], "rebuildable": true, "rebuild": "yarn install downloads again", "recommend": "delete"},
    {"name": "nvm-cache", "title": "nvm download cache", "category": "js", "paths": ["~/.nvm/.cache"], "rebuildable": true, "rebuild": "nvm install downloads again", "recommend": "delete"},
    {"name": "node-gyp", "title": "node-gyp header downloads", "category": "js", "paths": ["~/Library/Caches/node-gyp", "~/.cache/node-gyp"], "rebuildable": true, "rebuild": "a native module build downloads headers again", "recommend": "delete"},
    {"name": "corepack", "title": "corepack package-manager downloads", "category": "js", "paths": ["~/.cache/node/corepack"], "rebuildable": true, "rebuild": "corepack downloads on next use", "recommend": "delete"},
    {"name": "fnm-node-versions", "title": "fnm-installed node versions", "category": "js", "paths": ["~/.local/share/fnm/node-versions/*"], "rebuildable": false, "rebuild": "fnm install VERSION (global npm packages are lost)", "recommend": "keep", "notes": "remove an unused version with fnm uninstall; keep the default"},
    {"name": "typescript-cache", "title": "TypeScript typings cache", "category": "js", "paths": ["~/Library/Caches/typescript"], "rebuildable": true, "recommend": "delete"},
    {"name": "turbo-cache", "title": "Turborepo caches in projects", "category": "build", "paths": ["~/src/*/.turbo"], "rebuildable": true, "rebuild": "the next turbo run rebuilds", "recommend": "delete"},
    {"name": "homebrew-cache", "title": "Homebrew downloads", "category": "pkg", "paths": ["~/Library/Caches/Homebrew"], "rebuildable": true, "rebuild": "brew install/upgrade downloads again", "recommend": "delete"},
    {"name": "go-build-cache", "title": "Go build cache (default location)", "category": "go", "paths": ["~/Library/Caches/go-build"], "rebuildable": true, "rebuild": "the next go build", "recommend": "delete", "notes": "a symlink or GOCACHE elsewhere shows as relocated"},
    {"name": "go-mod-cache", "title": "Go module cache", "category": "go", "paths": ["~/go/pkg/mod"], "rebuildable": true, "rebuild": "go mod download (needs the network; private modules need access)", "clear": [["go", "clean", "-modcache"]], "recommend": "keep"},
    {"name": "pip-cache", "title": "pip wheel cache", "category": "python", "paths": ["~/Library/Caches/pip", "~/.cache/pip"], "rebuildable": true, "recommend": "delete"},
    {"name": "uv-cache", "title": "uv cache", "category": "python", "paths": ["~/.cache/uv"], "rebuildable": true, "clear": [["uv", "cache", "clean"]], "recommend": "delete"},
    {"name": "huggingface", "title": "Hugging Face model downloads", "category": "ai", "paths": ["~/.cache/huggingface"], "rebuildable": true, "rebuild": "models download again (slow, large)", "recommend": "relocate"},
    {"name": "lmstudio-models", "title": "LM Studio models", "category": "ai", "paths": ["~/.lmstudio/models"], "rebuildable": false, "rebuild": "download in LM Studio", "recommend": "relocate"},
    {"name": "codex-runtimes", "title": "Codex app runtimes", "category": "ai", "paths": ["~/.cache/codex-runtimes"], "rebuildable": true, "rebuild": "the Codex app downloads its runtime on start", "recommend": "delete", "notes": "quit Codex first"},
    {"name": "codex-tmp", "title": "Codex scratch", "category": "ai", "paths": ["~/.codex/.tmp"], "rebuildable": true, "recommend": "delete"},
    {"name": "cargo-registry", "title": "Cargo registry cache and sources", "category": "rust", "paths": ["~/.cargo/registry/cache", "~/.cargo/registry/src"], "rebuildable": true, "rebuild": "cargo build downloads again", "recommend": "delete"},
    {"name": "rustup-toolchains", "title": "rustup toolchains", "category": "rust", "paths": ["~/.rustup/toolchains"], "rebuildable": false, "rebuild": "rustup toolchain install", "recommend": "keep"},
    {"name": "gradle-cache", "title": "Gradle caches", "category": "jvm", "paths": ["~/.gradle/caches"], "rebuildable": true, "recommend": "delete"},
    {"name": "maven-repo", "title": "Maven local repository", "category": "jvm", "paths": ["~/.m2/repository"], "rebuildable": true, "recommend": "delete"},
    {"name": "bazel-cache", "title": "Bazel output and repository caches", "category": "build", "paths": ["~/Library/Caches/bazel", "~/.cache/bazel"], "rebuildable": true, "recommend": "delete", "notes": "read-only files: clear makes them writable first"},
    {"name": "ms-playwright", "title": "Playwright browsers", "category": "browser-test", "paths": ["~/Library/Caches/ms-playwright", "~/Library/Caches/ms-playwright-go"], "rebuildable": true, "rebuild": "npx playwright install", "recommend": "delete"},
    {"name": "puppeteer", "title": "Puppeteer browsers", "category": "browser-test", "paths": ["~/.cache/puppeteer"], "rebuildable": true, "rebuild": "npx puppeteer browsers install", "recommend": "delete"},
    {"name": "electron-cache", "title": "Electron and electron-builder downloads", "category": "js", "paths": ["~/Library/Caches/electron", "~/Library/Caches/electron-builder"], "rebuildable": true, "recommend": "delete"},
    {"name": "browser-arc", "title": "Arc cache", "category": "browser", "paths": ["~/Library/Caches/Arc"], "rebuildable": true, "rebuild": "the browser refills it", "recommend": "delete", "notes": "quit the browser first"},
    {"name": "browser-chrome", "title": "Google Chrome cache", "category": "browser", "paths": ["~/Library/Caches/Google"], "rebuildable": true, "rebuild": "the browser refills it", "recommend": "delete", "notes": "quit the browser first"},
    {"name": "browser-firefox", "title": "Firefox cache", "category": "browser", "paths": ["~/Library/Caches/Mozilla", "~/Library/Caches/Firefox"], "rebuildable": true, "rebuild": "the browser refills it", "recommend": "delete", "notes": "quit the browser first"},
    {"name": "browser-zen", "title": "Zen browser cache", "category": "browser", "paths": ["~/Library/Caches/zen"], "rebuildable": true, "rebuild": "the browser refills it", "recommend": "delete", "notes": "quit the browser first"},
    {"name": "browser-safari", "title": "Safari cache", "category": "browser", "paths": ["~/Library/Caches/com.apple.Safari"], "rebuildable": true, "recommend": "delete", "notes": "quit Safari first"},
    {"name": "jetbrains-cache", "title": "JetBrains IDE caches", "category": "ide", "paths": ["~/Library/Caches/JetBrains"], "rebuildable": true, "rebuild": "the IDE reindexes", "recommend": "delete"},
    {"name": "vscode-cache", "title": "VS Code caches", "category": "ide", "paths": ["~/Library/Application Support/Code/Cache", "~/Library/Application Support/Code/CachedData", "~/Library/Caches/com.microsoft.VSCode.ShipIt"], "rebuildable": true, "recommend": "delete"},
    {"name": "books", "title": "Apple Books downloads and asset cache", "category": "apple", "paths": ["~/Library/Containers/com.apple.BKAgentService", "~/Library/Caches/com.apple.bookassetd"], "rebuildable": false, "rebuild": "Books re-downloads purchased items; side-loaded books may be lost", "recommend": "keep", "notes": "remove downloads from inside Books"},
    {"name": "xcode-derived-data", "title": "Xcode DerivedData", "category": "apple", "paths": ["~/Library/Developer/Xcode/DerivedData"], "rebuildable": true, "rebuild": "the next Xcode build", "recommend": "delete"},
    {"name": "xcode-archives", "title": "Xcode archives", "category": "apple", "paths": ["~/Library/Developer/Xcode/Archives"], "rebuildable": false, "recommend": "relocate"},
    {"name": "ios-simulators", "title": "Simulator devices", "category": "apple", "paths": ["~/Library/Developer/CoreSimulator/Devices", "~/Library/Developer/CoreSimulator/Caches"], "rebuildable": true, "clear": [["xcrun", "simctl", "delete", "unavailable"]], "recommend": "delete"},
    {"name": "docker", "title": "Docker Desktop disk image (images, containers, volumes)", "category": "containers", "paths": ["~/Library/Containers/com.docker.docker"], "rebuildable": false, "rebuild": "images pull again; volumes are lost", "recommend": "keep", "notes": "free space inside Docker: docker system prune --all; move the image in Docker Desktop settings, not by copying"},
    {"name": "logs", "title": "User logs", "category": "logs", "paths": ["~/Library/Logs"], "rebuildable": true, "rebuild": "apps write new logs", "recommend": "delete"},
    {"name": "trash", "title": "Trash", "category": "personal", "paths": ["~/.Trash"], "rebuildable": false, "recommend": "keep", "notes": "empty it in Finder; reading it needs Full Disk Access"},
    {"name": "downloads", "title": "Downloads folder", "category": "personal", "paths": ["~/Downloads"], "rebuildable": false, "recommend": "relocate", "notes": "o-df top ~/Downloads lists the big files"},
    {"name": "movies", "title": "Movies folder", "category": "personal", "paths": ["~/Movies"], "rebuildable": false, "recommend": "relocate"}
  ]
}
